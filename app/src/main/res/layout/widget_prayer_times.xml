<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_compact_widget"
    android:orientation="vertical"
    android:padding="8dp"
    android:layoutDirection="rtl">

    <!-- Header: Location, Gregorian Date, Hijri Date (Non-overlapping 3-column layout) -->
    <LinearLayout
        android:id="@+id/layout_widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="0dp">

        <TextView
            android:id="@+id/tv_widget_city"
            android:layout_width="0dp"
            android:layout_weight="0.6"
            android:layout_height="wrap_content"
            android:text="الجزائر العاصمة"
            android:textColor="#1E4A38"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_widget_gregorian"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="08 أكتوبر 2026"
            android:textColor="#5C6B63"
            android:textSize="11sp"
            android:layout_marginHorizontal="4dp"
            android:maxLines="1"
            android:gravity="center" />

        <TextView
            android:id="@+id/tv_widget_hijri"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="1448 هـ"
            android:textColor="#5C6B63"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Next Prayer Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_countdown_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/tv_widget_next_prayer_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="الصلاة القادمة: المغرب (الإفطار)"
            android:textColor="#1E4A38"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_widget_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="4dp"
            android:paddingVertical="3dp"
            android:text="00:45:12"
            android:textColor="#1E4A38"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Prayer Times Grid / Row -->
    <GridLayout
        android:id="@+id/prayer_times_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:columnCount="7"
        android:orientation="horizontal"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="false">

        <!-- Imsak -->
        <LinearLayout
            android:id="@+id/layout_widget_imsak"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_widget_imsak_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الإمساك"
                android:textColor="#5C6B63"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/tv_widget_imsak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="04:30"
                android:textColor="#1E4A38"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Fajr -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_widget_fajr_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الفجر"
                android:textColor="#1E4A38"
                android:textSize="9sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_widget_fajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="04:45"
                android:textColor="#1E4A38"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Sunrise -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_widget_sunrise_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الشروق"
                android:textColor="#5C6B63"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/tv_widget_sunrise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="06:12"
                android:textColor="#3A4A42"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Dhuhr -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_widget_dhuhr_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الظهر"
                android:textColor="#5C6B63"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/tv_widget_dhuhr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:30"
                android:textColor="#3A4A42"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Asr -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_widget_asr_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العصر"
                android:textColor="#5C6B63"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/tv_widget_asr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15:45"
                android:textColor="#3A4A42"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Maghrib -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_widget_maghrib_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الإفطار"
                android:textColor="#1E4A38"
                android:textSize="9sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_widget_maghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18:35"
                android:textColor="#1E4A38"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Isha -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_widget_isha_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العشاء"
                android:textColor="#5C6B63"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/tv_widget_isha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20:00"
                android:textColor="#3A4A42"
                android:textSize="10sp" />
        </LinearLayout>
    </GridLayout>
</LinearLayout>
